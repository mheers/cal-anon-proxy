# Visibility window in weeks (defaults: 4 back, 8 forward). Events outside
# the window are dropped; recurring events are always kept.
WINDOW_PAST_WEEKS=
WINDOW_FUTURE_WEEKS=
SRC_UPDATE_INTERVAL=
COMPACT_OVERLAPPING_EVENTS=
SRC_1_URL=
SRC_1_ANON=
SRC_1_USERNAME=
SRC_1_PASSWORD=
SRC_2_URL=
SRC_2_ANON=
SRC_2_USERNAME=
SRC_2_PASSWORD=
SRC_3_URL=
SRC_3_ANON=
SRC_3_USERNAME=
SRC_3_PASSWORD=
DST_AUTH_ENABLED=
DST_USERNAME=
DST_PASSWORD=
DST_PUBLIC_DOMAIN=

# --- Multitenancy (optional) ---
# Each TENANT_<N>_* block defines one tenant with a short name. The tenant's
# WebUI lives at /<name> (e.g. /marcel), its feeds at /<name>/calendar.ics
# and /<name>/events.json, and its CalDAV endpoint at /<name>/caldav/.
# Numbering need not be contiguous; up to 64 tenants are scanned.
# Names must be lowercase alphanumeric with dashes, and must not be one of:
# public, caldav, calendar.ics, events.json, .well-known.
# When any TENANT_*_NAME is set, the legacy routes (/, /caldav/,
# /calendar.ics, /events.json) alias the first tenant, and legacy
# SRC_*/DST_* sources are ignored. Visibility window, compaction and refresh
# interval stay global (see above).
# TENANT_1_NAME=marcel
# TENANT_1_WEBUI_ENABLED=true
# TENANT_1_SRC_1_URL=
# TENANT_1_SRC_1_ANON=
# TENANT_1_SRC_1_USERNAME=
# TENANT_1_SRC_1_PASSWORD=
# TENANT_1_SRC_2_URL=
# TENANT_1_SRC_2_ANON=
# TENANT_1_SRC_2_USERNAME=
# TENANT_1_SRC_2_PASSWORD=
# TENANT_1_DST_AUTH_ENABLED=
# TENANT_1_DST_USERNAME=
# TENANT_1_DST_PASSWORD=
# TENANT_2_NAME=josephine
# TENANT_2_WEBUI_ENABLED=false
# TENANT_2_SRC_1_URL=
# TENANT_2_SRC_1_ANON=
# TENANT_2_SRC_1_USERNAME=
# TENANT_2_SRC_1_PASSWORD=
# TENANT_2_DST_AUTH_ENABLED=
# TENANT_2_DST_USERNAME=
# TENANT_2_DST_PASSWORD=
